      "skills": [
        {
          "label": "寒冰彈，投入 20 點，常駐等級 42，戰鬥指揮後 43",
          "detail": "冰寒協同\n寒冰彈\n投入點數\n20\n常駐完成\n42\n戰鬥指揮後\n43\n穿戴通用\n+7\n火炬／毀符\n+4\n分支加成\n+11\n\n投入 20 點作為共用協同，讓暴風雪與冰封球兩條輸出線都獲得支援。這套已同時投滿兩個主攻技能，寒冰彈的價值在於每個硬點都能服務整體配置；實戰以暴風雪鋪場、冰封球掃射為主，需要集中補刀時改用寒冰球，無須把寒冰彈排進固定循環。\n\n技能分支\n冰寒法術\n配置狀態\n核心滿點\n常駐完成為正手配裝等級；施放戰鬥指揮並切回正手後提高 1 級。"
        },
        {
          "label": "冰封甲，投入 1 點，常駐等級 23，戰鬥指揮後 24",
          "detail": "防禦功能\n冰封甲\n投入點數\n1\n常駐完成\n23\n戰鬥指揮後\n24\n穿戴通用\n+7\n火炬／毀符\n+4\n分支加成\n+11\n\n投入 1 點即可利用冰寒裝備加成提升防禦，近戰敵人命中時也能觸發凍結，替傳送脫離爭取空間。進場前先施放，效果消失後再補；這套把主要點數保留給傷害與協同，冰封甲只提供額外保護，仍需用站位避免連續承受近戰攻擊。\n\n技能分支\n冰寒法術\n配置狀態\n前置／功能點\n常駐完成為正手配裝等級；施放戰鬥指揮並切回正手後提高 1 級。"
        },
        {
          "label": "冰霜新星，投入 1 點，常駐等級 23，戰鬥指揮後 24",
          "detail": "前置／控場\n冰霜新星\n投入點數\n1\n常駐完成\n23\n戰鬥指揮後\n24\n穿戴通用\n+7\n火炬／毀符\n+4\n分支加成\n+11\n\n投入 1 點打通暴風雪與冰封球的前置路線，貼近的怪群也可用它緩速後再傳送拉開。這套沒有為冰霜新星追加硬點，清圖仍依賴暴風雪與冰封球，不必為了施放它主動進入包圍。\n\n技能分支\n冰寒法術\n配置狀態\n前置／功能點\n常駐完成為正手配裝等級；施放戰鬥指揮並切回正手後提高 1 級。"
        },
        {
          "label": "寒冰球，投入 20 點，常駐等級 42，戰鬥指揮後 43",
          "detail": "單體／補刀\n寒冰球\n投入點數\n20\n常駐完成\n42\n戰鬥指揮後\n43\n穿戴通用\n+7\n火炬／毀符\n+4\n分支加成\n+11\n\n投入 20 點兼顧暴風雪協同與集中補刀，主手傷害為 8,567–8,787。暴風雪已覆蓋目標時，可連續施放寒冰球追打精英或首領；對可凍結的一般怪物還能限制行動。怪群擠成一團時則換冰川之槍，依單體傷害與範圍控場需求切換。\n\n技能分支\n冰寒法術\n配置狀態\n核心滿點\n常駐完成為正手配裝等級；施放戰鬥指揮並切回正手後提高 1 級。"
        },
        {
          "label": "冰川之槍，投入 20 點，常駐等級 42，戰鬥指揮後 43",
          "detail": "群體控場\n冰川之槍\n投入點數\n20\n常駐完成\n42\n戰鬥指揮後\n43\n穿戴通用\n+7\n火炬／毀符\n+4\n分支加成\n+11\n\n投入 20 點提供暴風雪協同，主手傷害為 3,515–3,692；實戰價值在於命中後凍結附近可受凍結的敵人。先讓怪群停在暴風雪覆蓋區，再用冰封球補足火力，可減少移動造成的空檔。只剩精英或首領時，改用寒冰球集中補刀更符合這套分工。\n\n技能分支\n冰寒法術\n配置狀態\n核心滿點\n常駐完成為正手配裝等級；施放戰鬥指揮並切回正手後提高 1 級。"
        },
        {
          "label": "暴風雪，投入 20 點，常駐等級 42，戰鬥指揮後 43",
          "detail": "主要範圍輸出\n暴風雪\n投入點數\n20\n常駐完成\n42\n戰鬥指揮後\n43\n穿戴通用\n+7\n火炬／毀符\n+4\n分支加成\n+11\n\n投入 20 點擔任主要範圍輸出，主手傷害約 12K，並由寒冰彈、寒冰球與冰川之槍的硬點支援。優先落在怪群聚集處或前進路線，施放間隔穿插冰封球與寒冰球；怪物離開原區域時再調整落點，讓傭兵承接前排以維持有效覆蓋。\n\n技能分支\n冰寒法術\n配置狀態\n核心滿點\n常駐完成為正手配裝等級；施放戰鬥指揮並切回正手後提高 1 級。"
        },
        {
          "label": "冰封球，投入 20 點，常駐等級 42，戰鬥指揮後 43",
          "detail": "副輸出\n冰封球\n投入點數\n20\n常駐完成\n42\n戰鬥指揮後\n43\n穿戴通用\n+7\n火炬／毀符\n+4\n分支加成\n+11\n\n投入 20 點補足暴風雪之外的移動覆蓋，主手傷害為 1,273–1,329，寒冰彈提供協同支援。讓冰封球穿過怪群，並調整站位使末端爆散接近高血量目標；它適合追掃分散或移動中的敵人，也可穿插在暴風雪循環內，減少等待下一次鋪場的空檔。\n\n技能分支\n冰寒法術\n配置狀態\n核心滿點\n常駐完成為正手配裝等級；施放戰鬥指揮並切回正手後提高 1 級。"
        },
        {
          "label": "冰寒專精，投入 4 點，常駐等級 26，戰鬥指揮後 27",
          "detail": "穿透冰抗\n冰寒專精\n投入點數\n4\n常駐完成\n26\n戰鬥指揮後\n27\n穿戴通用\n+7\n火炬／毀符\n+4\n分支加成\n+11\n\n投入 4 點，主手達 26 級，對非免疫目標降低 145% 冰寒抗性，再配合裝備降抗提升實際傷害。原本冰寒免疫的敵人破免後，專精只套用五分之一效果。此處保留有限硬點，把其餘點數投向雙主攻與協同；更換降抗裝備時再一併評估專精需求。\n\n技能分支\n冰寒法術\n配置狀態\n功能投資\n常駐完成為正手配裝等級；施放戰鬥指揮並切回正手後提高 1 級。"
        }
      ]
