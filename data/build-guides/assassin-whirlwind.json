  "skills": [
    {
      "tree": "武學技藝 0 硬點",
      "skills": [
        {
          "label": "翔龍腳，常駐等級 15",
          "detail": "武學位移\n翔龍腳\n投入點數\n0\n常駐完成\n15\n戰鬥指揮後\n16\n穿戴通用\n+8\n火炬／毀符\n+4\n分支／單技\n+3\n\n混沌爪直接賦予翔龍腳，無需額外投入技能點。它可貼近落單目標或越過短距離障礙；落點若有密集火力，先讓雷光衛哨削血或以傳送集結米山，主輸出仍交給旋風與陷阱。\n\n技能分支\n武學技藝\n配置狀態\n裝備賦予\n一般的技能加成不會解鎖尚未投入的技能。"
        }
      ]
    },
    {
      "tree": "暗影修行 48 硬點",
      "skills": [
        {
          "label": "利爪專精，常駐等級 43",
          "detail": "暗影支援\n利爪專精\n投入點數\n20\n常駐完成\n43\n戰鬥指揮後\n44\n穿戴通用\n+8\n火炬／毀符\n+4\n分支／單技\n+11\n\n爪類傷害、準確率與致命打擊會一起影響旋風的物理部分。這套以短旋風製造第一具屍體，命中後才能吸血、吸魔；利爪專精與頭冠的準確率加成對首屍速度都有幫助。\n\n技能分支\n暗影修行\n配置狀態\n核心滿點\n常駐完成為正手配裝等級；施放戰鬥指揮並切回正手後提高 1 級。"
        },
        {
          "label": "速度爆發，常駐等級 24",
          "detail": "暗影支援\n速度爆發\n投入點數\n1\n常駐完成\n24\n戰鬥指揮後\n25\n穿戴通用\n+8\n火炬／毀符\n+4\n分支／單技\n+11\n\n提升移動與攻擊速度，適合較安全的地圖或需要快速調整落點時使用。速度爆發與影散不能同時生效；切換後要重新確認四抗與物理減傷，不把兩種狀態的優點加在一起。\n\n技能分支\n暗影修行\n配置狀態\n前置／功能點\n常駐完成為正手配裝等級；施放戰鬥指揮並切回正手後提高 1 級。"
        },
        {
          "label": "武器格擋，常駐等級 24",
          "detail": "暗影支援\n武器格擋\n投入點數\n1\n常駐完成\n24\n戰鬥指揮後\n25\n穿戴通用\n+8\n火炬／毀符\n+4\n分支／單技\n+11\n\n雙爪時提供對攻擊與部分法術的格擋，短旋風穿過怪群可多一層容錯。技能等級越高，格擋率提升逐漸變小；配裝取捨仍要同時考慮生命與抗性。\n\n技能分支\n暗影修行\n配置狀態\n前置／功能點\n常駐完成為正手配裝等級；施放戰鬥指揮並切回正手後提高 1 級。"
        },
        {
          "label": "影散，常駐等級 29",
          "detail": "暗影支援\n影散\n投入點數\n6\n常駐完成\n29\n戰鬥指揮後\n30\n穿戴通用\n+8\n火炬／毀符\n+4\n分支／單技\n+11\n\n進階面板顯示物理傷害降低 37%，其中謎團 8%、影散等級 29 提供 29%。切成速度爆發後便失去影散的抗性與物理減傷，應按地圖傷害決定是否切換。\n\n技能分支\n暗影修行\n配置狀態\n功能投資\n常駐完成為正手配裝等級；施放戰鬥指揮並切回正手後提高 1 級。"
        },
        {
          "label": "心靈震爆，常駐等級 26",
          "detail": "暗影支援\n心靈震爆\n投入點數\n0\n常駐完成\n26\n戰鬥指揮後\n27\n穿戴通用\n+8\n火炬／毀符\n+4\n分支／單技\n+14\n\n混沌爪直接提供心靈震爆，不占用硬點。怪群在傳送落地後圍近時，先擊退或轉化一部分敵人，再補雷光衛哨並選短旋風路線；被轉化的怪物不宜當作第一具屍體的優先目標。\n\n技能分支\n暗影修行\n配置狀態\n裝備賦予\n一般的技能加成不會解鎖尚未投入的技能。"
        },
        {
          "label": "淬毒，常駐等級 43",
          "detail": "暗影支援\n淬毒\n投入點數\n20\n常駐完成\n43\n戰鬥指揮後\n44\n穿戴通用\n+8\n火炬／毀符\n+4\n分支／單技\n+11\n\n先施放淬毒，再以旋風把短時毒傷附在實際命中的目標上。面板顯示了旋風淬毒前後的兩組傷害：兩爪從 1160–2358／873–1754 提升到 3078–4326／2789–3719。塔格奧之爪的毒傷加成與瘟疫爪的降毒抗是不同作用；同一目標的毒傷不會隨旋風命中次數無限累積。\n\n技能分支\n暗影修行\n配置狀態\n核心滿點\n常駐完成為正手配裝等級；施放戰鬥指揮並切回正手後提高 1 級。"
        },
        {
          "label": "暗影宗師，常駐等級 26",
          "detail": "暗影支援\n暗影宗師\n投入點數\n0\n常駐完成\n26\n戰鬥指揮後\n27\n穿戴通用\n+8\n火炬／毀符\n+4\n分支／單技\n+14\n\n瘟疫副爪賦予暗影宗師，並由暗影板與裝備技能推高常駐等級。它能分散近戰與遠程怪物的注意力，幫旋風刺爭取佈陷阱和挑選首屍的時間；傳送換區或宗師死亡後記得重新召喚。\n\n技能分支\n暗影修行\n配置狀態\n裝備賦予\n一般的技能加成不會解鎖尚未投入的技能。"
        }
      ]
    },
    {
      "tree": "陷阱 62 硬點",
      "skills": [
        {
          "label": "火焰轟擊，常駐等級 13",
          "detail": "電陷阱與屍爆\n火焰轟擊\n投入點數\n1\n常駐完成\n13\n戰鬥指揮後\n14\n穿戴通用\n+8\n火炬／毀符\n+4\n分支／單技\n+0\n\n通往雷電網的前置點，也能在需要時手動丟出補火焰傷害。這套實際清圖以雷光衛哨、旋風與死亡衛哨連鎖為主，火焰轟擊不是常態主輸出。\n\n技能分支\n陷阱\n配置狀態\n前置／功能點\n常駐完成為正手配裝等級；施放戰鬥指揮並切回正手後提高 1 級。"
        },
        {
          "label": "雷電網，常駐等級 32",
          "detail": "電陷阱與屍爆\n雷電網\n投入點數\n20\n常駐完成\n32\n戰鬥指揮後\n33\n穿戴通用\n+8\n火炬／毀符\n+4\n分支／單技\n+0\n\n滿點作為雷光衛哨的協同傷害來源。電陷阱可以在旋風接敵前先削血，對高物抗或高毒抗的怪尤其有用；它不是單純為了湊出第一具屍體。\n\n技能分支\n陷阱\n配置狀態\n核心滿點\n常駐完成為正手配裝等級；施放戰鬥指揮並切回正手後提高 1 級。"
        },
        {
          "label": "電能衛哨，常駐等級 32",
          "detail": "電陷阱與屍爆\n電能衛哨\n投入點數\n20\n常駐完成\n32\n戰鬥指揮後\n33\n穿戴通用\n+8\n火炬／毀符\n+4\n分支／單技\n+0\n\n另一項滿點的雷光衛哨協同。投入這條電系軸讓無限的信念有實際受益目標；遇到無法安全貼近的怪群，也能先用陷阱削血再短旋風補刀。\n\n技能分支\n陷阱\n配置狀態\n核心滿點\n常駐完成為正手配裝等級；施放戰鬥指揮並切回正手後提高 1 級。"
        },
        {
          "label": "雷光衛哨，常駐等級 38",
          "detail": "電陷阱與屍爆\n雷光衛哨\n投入點數\n20\n常駐完成\n38\n戰鬥指揮後\n39\n穿戴通用\n+8\n火炬／毀符\n+4\n分支／單技\n+6\n\n正手雙爪各提供 +3 雷光衛哨，技能樹顯示 38 級；面板的閃電傷害為 1–8249。佈署時朝怪群縱深讓閃電穿過多個目標，並把米山傳送到能用信念覆蓋的位置。\n\n技能分支\n陷阱\n配置狀態\n核心滿點\n常駐完成為正手配裝等級；施放戰鬥指揮並切回正手後提高 1 級。"
        },
        {
          "label": "死亡衛哨，常駐等級 13",
          "detail": "電陷阱與屍爆\n死亡衛哨\n投入點數\n1\n常駐完成\n13\n戰鬥指揮後\n14\n穿戴通用\n+8\n火炬／毀符\n+4\n分支／單技\n+0\n\n死亡衛哨常駐 13 級，投入一個功能點。第一具屍體出現後，屍爆與雷光衛哨共用五座陷阱上限；等級主要擴大屍爆範圍，不提高每次取怪物生命的比例。\n\n技能分支\n陷阱\n配置狀態\n前置／功能點\n常駐完成為正手配裝等級；施放戰鬥指揮並切回正手後提高 1 級。"
        },
        {
          "label": "利刃之盾，常駐等級 15",
          "detail": "電陷阱與屍爆\n利刃之盾\n投入點數\n0\n常駐完成\n15\n戰鬥指揮後\n16\n穿戴通用\n+8\n火炬／毀符\n+4\n分支／單技\n+3\n\n利刃之盾由瘟疫爪賦予，常駐 15 級且無需投入硬點。先用副手戰爭召喚喊血，切回混沌＋瘟疫後才能施放利刃之盾；面板顯示 2337–3249 傷害及 6062 準確率。它補近身物理傷害並帶出淬毒，清群仍以旋風和電陷阱為主。\n\n技能分支\n陷阱\n配置狀態\n裝備賦予\n一般的技能加成不會解鎖尚未投入的技能。"
        }
      ]
    }
